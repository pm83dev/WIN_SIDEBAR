<Window x:Class="SidebarDock.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SidebarDock"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{StaticResource DockBackground}"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        Left="0"
        Top="0"
        Width="64">

    <Grid x:Name="RootGrid">
        <Grid.ContextMenu>
            <!-- Opened/Closed: la finestra è Topmost, e un ContextMenu di WPF su una finestra
                 Topmost finisce renderizzato *dietro* di essa (problema noto). Si disattiva
                 temporaneamente Topmost mentre il menu è aperto per farlo comparire sopra. -->
            <ContextMenu Opened="OnContextMenuOpened"
                         Closed="OnContextMenuClosed">
                <MenuItem Header="Impostazioni…"
                          Click="OnOpenSettingsClick"/>
                <Separator/>
                <MenuItem Header="Esci"
                          Click="OnExitClick"/>
            </ContextMenu>
        </Grid.ContextMenu>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <!-- Icone app, occupa tutto lo spazio disponibile -->
            <RowDefinition Height="Auto"/>
            <!-- Blocco metriche risorse, sempre in fondo -->
        </Grid.RowDefinitions>
        <!-- L'orientamento (verticale per Left/Right, orizzontale per Top/Bottom)
             viene applicato a runtime da MainWindow.ApplyLayoutForEdge in base a config.json. -->

        <!-- Elenco app: nello ScrollViewer perché con molte icone la lista può superare
             lo spazio disponibile — l'orientamento di scroll viene impostato a runtime
             da ApplyLayoutForEdge in base al bordo (verticale per Left/Right, orizzontale
             per Top/Bottom), assieme a quello dello StackPanel interno. -->
        <ScrollViewer x:Name="AppScrollViewer"
                      Grid.Row="0"
                      Margin="0,12,0,0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Style="{StaticResource HiddenScrollbarScrollViewerStyle}">
            <ItemsControl x:Name="AppItemsControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource DockIconButton}"
                                Click="OnAppIconClick"
                                Tag="{Binding}"
                                ToolTip="{Binding Name}">
                            <Grid>
                                <!-- Icona reale estratta da ExecutablePath (IconExtractor); se non
                                     risolvibile (es. argomenti shell) resta visibile solo la lettera. -->
                                <Image x:Name="IconImage"
                                       Source="{Binding IconSource}"
                                       Width="30"
                                       Height="30"/>
                                <TextBlock x:Name="FallbackText"
                                           Text="{Binding Name[0]}"
                                           FontSize="18"
                                           Foreground="White"
                                           FontWeight="Bold"
                                           Visibility="Collapsed"/>
                            </Grid>
                        </Button>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IconSource}"
                                         Value="{x:Null}">
                                <Setter TargetName="IconImage"
                                        Property="Visibility"
                                        Value="Collapsed"/>
                                <Setter TargetName="FallbackText"
                                        Property="Visibility"
                                        Value="Visible"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Blocco metriche risorse -->
        <StackPanel x:Name="MetricsPanel"
                    Grid.Row="1"
                    Margin="4,0,4,12"
                    HorizontalAlignment="Center">
            <TextBlock x:Name="DateText"
                       Foreground="Orange"
                       FontSize="11"
                       HorizontalAlignment="Center"
                       Text="--/--/--"/>
            <TextBlock x:Name="TimeText"
                       Foreground="Orange"
                       FontSize="11"
                       HorizontalAlignment="Center"
                       Text="--:--"/>
            <TextBlock x:Name="CpuText"
                       Foreground="Orange"
                       FontSize="11"
                       HorizontalAlignment="Center"
                       Text="CPU --%"/>
            <TextBlock x:Name="RamText"
                       Foreground="Orange"
                       FontSize="11"
                       HorizontalAlignment="Center"
                       Text="RAM --%"
                       Margin="0,4,0,0"/>
            <TextBlock x:Name="DiskText"
                       Foreground="Orange"
                       FontSize="11"
                       HorizontalAlignment="Center"
                       Text="Disco -- GB"
                       Margin="0,4,0,0"/>
            <TextBlock x:Name="NetText"
                       Foreground="Orange"
                       FontSize="11"
                       HorizontalAlignment="Center"
                       Text="↓-- ↑--"
                       Margin="0,4,0,0"/>
        </StackPanel>

    </Grid>
</Window>
