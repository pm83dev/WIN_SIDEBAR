<Window x:Class="SidebarDock.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Impostazioni SidebarDock"
        Width="360"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#FF252525">

    <StackPanel Margin="20">
        <TextBlock Text="Posizione e dimensione" Foreground="White" FontWeight="Bold" FontSize="14" Margin="0,0,0,14"/>

        <CheckBox x:Name="FloatingCheckBox" Foreground="White" Margin="0,0,0,16"
                  Checked="OnModeChanged" Unchecked="OnModeChanged">
            <TextBlock Text="Finestra libera (si trascina e ridimensiona col mouse, non ancorata al bordo)"
                       TextWrapping="Wrap" Foreground="White"/>
        </CheckBox>

        <StackPanel x:Name="AnchoredOptionsPanel">
            <TextBlock Text="Bordo dello schermo" Foreground="#CCCCCC" Margin="0,0,0,4"/>
            <ComboBox x:Name="EdgeComboBox" Margin="0,0,0,16">
                <ComboBoxItem Content="Sinistra" Tag="Left"/>
                <ComboBoxItem Content="Destra" Tag="Right"/>
                <ComboBoxItem Content="Sopra" Tag="Top"/>
                <ComboBoxItem Content="Sotto" Tag="Bottom"/>
            </ComboBox>

            <DockPanel Margin="0,0,0,4">
                <TextBlock Text="Spessore" Foreground="#CCCCCC"/>
                <TextBlock x:Name="ThicknessValueText" DockPanel.Dock="Right" Foreground="White"/>
            </DockPanel>
            <Slider x:Name="ThicknessSlider" Minimum="48" Maximum="160" TickFrequency="8"
                    IsSnapToTickEnabled="True" ValueChanged="OnThicknessChanged" Margin="0,0,0,16"/>
        </StackPanel>

        <TextBlock Text="Il cambio tra ancorata e libera richiede il riavvio dell'app; bordo e spessore si applicano subito."
                   Foreground="#999999" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,18"/>

        <Separator Margin="0,0,0,14"/>

        <TextBlock Text="Configurazione avanzata" Foreground="White" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>
        <TextBlock Text="Le app della barra, e ogni altra opzione, si modificano a mano nel file config.json."
                   Foreground="#999999" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>
        <Button x:Name="OpenConfigButton" Content="Apri config.json" HorizontalAlignment="Left"
                Padding="10,6" Margin="0,0,0,18" Click="OnOpenConfigClick"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" Content="Annulla" Width="84" Margin="0,0,8,0" Padding="0,6" Click="OnCancelClick"/>
            <Button x:Name="ApplyButton" Content="Applica" Width="84" Padding="0,6" Click="OnApplyClick"/>
        </StackPanel>
    </StackPanel>
</Window>
